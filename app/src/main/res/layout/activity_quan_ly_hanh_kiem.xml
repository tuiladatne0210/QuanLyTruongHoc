<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:text="KHEN THƯỞNG / KỶ LUẬT"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView text="Chọn Học Sinh:" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Spinner
        android:id="@+id/spnHocSinhHK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/edtNoiDungHK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nội dung (VD: Đi học muộn, Giỏi...)" />

    <Button
        android:id="@+id/btnThemHK"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ghi nhận" />

    <ListView
        android:id="@+id/lvHanhKiem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"/>
</LinearLayout>